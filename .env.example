# Groq is the primary provider: Gemini's free tier caps at 20 requests/day (confirmed live),
# which cannot support the Phase 8 eval grid. Groq's free tier is used only for the Phase 8
# cross-model robustness check (a small sample, not the full grid) — see docs/PROGRESS.md.
APP_ENV=development
LOG_LEVEL=INFO
LLM_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_MAX_CALLS_PER_RUN=200
PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RECONCILE_POLL_INTERVAL_SECONDS=30
DATA_DIR=data
