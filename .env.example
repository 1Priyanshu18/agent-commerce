# Groq is the default provider. Gemini and Anthropic are supported alternatives; see
# core/llm/ for the provider-agnostic adapter layer.
APP_ENV=development
LOG_LEVEL=INFO
LLM_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_MAX_CALLS_PER_RUN=200
PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RECONCILE_POLL_INTERVAL_SECONDS=30
DATA_DIR=data
# Gates the Streamlit app's Live run tab. Leave DEMO_PASSPHRASE blank to keep the gate
# permanently closed (fails closed, not open) on a deployment that shouldn't allow live
# runs at all.
DEMO_PASSPHRASE=
DEMO_MAX_CALLS_PER_SESSION=20
DEMO_DAILY_CALL_BUDGET=50
